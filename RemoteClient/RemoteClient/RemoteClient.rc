/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\RemoteClient.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 RemoteClient"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "RemoteClient，版本 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "版权所有 (C) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_REMOTECLIENT_DIALOG DIALOGEX 0, 0, 511, 355
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "远程控制客户端"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "连接测试",IDC_BTN_TEST,370,23,50,14
    EDITTEXT        IDC_EDIT_PORT,322,23,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "端口：",IDC_STATIC,295,26,22,8
    LTEXT           "对方的地址：",IDC_STATIC,141,26,42,8
    CONTROL         "",IDC_IPADDRESS_Serv,"SysIPAddress32",WS_TABSTOP,186,23,100,15
    GROUPBOX        "",IDC_STATIC,138,81,366,267
    CONTROL         "",IDC_TREE_DIR,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_DISABLEDRAGDROP | TVS_SHOWSELALWAYS | TVS_NOTOOLTIPS | TVS_TRACKSELECT | TVS_SINGLEEXPAND | WS_BORDER | WS_HSCROLL | WS_TABSTOP,140,85,174,254
    CONTROL         "",IDC_LIST_FILE,"SysListView32",LVS_LIST | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,319,85,187,252
    LTEXT           "对方的目录：",IDC_STATIC,140,67,47,14
    LTEXT           "文件：",IDC_STATIC,319,67,31,9
    PUSHBUTTON      "查看文件信息",IDC_BTN_FILEINFO,185,65,50,14
    PUSHBUTTON      "远程监控",IDC_BTN_START_WATCH,433,23,50,14
END

IDD_DLG_STATUS DIALOGEX 0, 0, 301, 57
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
CAPTION "正在处理..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_EDIT_INFO,7,7,280,35,ES_MULTILINE | ES_AUTOHSCROLL | ES_READONLY,WS_EX_CLIENTEDGE
END

IDD_DLG_WATCH DIALOGEX 0, 0, 803, 451
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "监视对话框"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_WATCH,"Static",SS_BLACKFRAME,0,25,800,426
    PUSHBUTTON      "锁机",IDC_BTN_LOCK,642,8,50,14
    PUSHBUTTON      "解锁",IDC_BTN_UNLOCK,701,8,50,14
END


